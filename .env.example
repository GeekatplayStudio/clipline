# Hostinger API & Deployment Configuration
# Justification: Environment variables for automated deployment to Hostinger hosting/subdomain.

# Your Hostinger API Token (generated in Hostinger Account -> API Management)
HOSTINGER_API_TOKEN=your_hostinger_api_token_here

# Target Domain or Subdomain (e.g., vladimirchopine.com or registry.vladimirchopine.com)
HOSTINGER_DOMAIN=vladimirchopine.com
HOSTINGER_USERNAME=your_hostinger_account_username
HOSTINGER_SUBDOMAIN=registry

# Required acknowledgement for the legacy Git-branch deployment script.
ALLOW_FORCE_DEPLOY=false

# Explicit Git remote used by the legacy Git-branch deployment script.
DEPLOY_REPOSITORY_URL=

# Target Deployment Path on Hostinger (e.g., /public_html/registry or /public_html)
HOSTINGER_REMOTE_PATH=/public_html/registry

# Optional: Hostinger FTP / SFTP fallback credentials
HOSTINGER_FTP_HOST=
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
